# ============================================================
# ZUTO GeoTech Solutions — Environment Configuration
# ============================================================
# IMPORTANT: This file contains secrets. NEVER commit to git.
#            Add .env to your .gitignore immediately.
# ============================================================

# ── MongoDB Connections ──────────────────────────────────────
# Read-Write connection (for pipeline writes)
MONGO_URI=mongodb+srv://gopik0586_db_RW:<PASSWORD>@remotesensingapplicatio.zlgxohx.mongodb.net/?appName=RemoteSensingApplications

# Read-Only connection (for dashboard/API reads)
MONGO_URI_RO=mongodb+srv://gopik0586_db_RO:<PASSWORD>@remotesensingapplicatio.zlgxohx.mongodb.net/?appName=RemoteSensingApplications

# MongoDB database name
MONGO_DB_NAME=zuto_geotech

# ── API Keys ─────────────────────────────────────────────────
# Microsoft Planetary Computer (Sentinel-2 / Landsat data)
PLANETARY_COMPUTER_API_KEY=

# NASA POWER API (weather data — no key required currently)
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# AgMarkNet (mandi price data)
AGMARKNET_API_KEY=

# ── FastAPI Settings ─────────────────────────────────────────
API_SECRET_KEY=change_this_to_a_random_secret_key_before_production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application Settings ──────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
OUTPUT_DIR=outputs/
